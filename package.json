{
  "name": "diffdump",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5001",
    "generate-routes": "tsr generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --vitest-plugin --deny-warnings --ignore-pattern src/routeTree.gen.ts src vite.config.ts vitest.config.ts && tsc --noEmit",
    "build": "vite build && pnpm bundle:check && tsc --noEmit",
    "analyze": "vite build --mode analyze && pnpm bundle:check",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pierre/diffs": "1.3.0-rc.3",
    "@pierre/icons": "^0.7.1",
    "@pierre/trees": "^1.0.0-beta.6",
    "@shikijs/themes": "^4.3.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.12.1",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
