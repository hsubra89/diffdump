{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diffdump",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "diffdump.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.diffdump.com",
      "custom_domain": true,
    },
  ],
  "main": "@tanstack/react-start/server-entry",
  "r2_buckets": [
    {
      "binding": "DIFFS",
      "bucket_name": "diffdump-diffs",
    },
  ],
  "ratelimits": [
    {
      "name": "DIFF_CREATION_RATE_LIMITER",
      // This namespace ID must remain unique within the Cloudflare account.
      "namespace_id": "2026072801",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
